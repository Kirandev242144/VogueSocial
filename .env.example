# Frontend Mode Configuration
# 'mock': 100% standalone frontend with in-browser LocalStorage persistence (default)
VITE_DATA_SOURCE=mock

# Google OAuth Client ID (optional, for client-side Google Sign-In)
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# GPU AI Try-On Endpoints (optional client-side AI demo)
NEXT_PUBLIC_VTON_API_URL=your_runpod_tryon_endpoint_url

